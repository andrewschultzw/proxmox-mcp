# Proxmox API
PROXMOX_HOST=192.168.1.10
PROXMOX_PORT=8006
PROXMOX_USER=mcp@pve
PROXMOX_TOKEN_NAME=claude
PROXMOX_TOKEN_VALUE=

# Safety: per-category enable flags (everything off => read-only)
ALLOW_PROVISION=false
ALLOW_POWER=false
ALLOW_SNAPSHOT=false
ALLOW_BACKUP=false
ALLOW_DESTROY=false

# Protected production IDs (refuse harmful ops) and the freely-managed lab range
PROTECTED_IDS=100-115,200,205,300-302
MANAGED_RANGE=400-499

# Public key injected into newly created LXCs (CT 300's key)
CT300_SSH_PUBKEY=

# --- HTTP transport (Plan B) ---
# NOTE: the .env loader does NOT strip inline comments — keep every comment on
# its own line. A trailing "# ..." after a value becomes part of the value.
#
# MCP_TRANSPORT: stdio | http (leave stdio for local stdio use)
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=3000
# MCP_BIND_ADDR: set to CT 300's LAN IP when fronted by NPM
MCP_BIND_ADDR=127.0.0.1
# MCP_BEARER_TOKEN: required for http; a long random secret
MCP_BEARER_TOKEN=
# MCP_ALLOWED_HOSTS: comma list, e.g. proxmox-mcp.schultzsolutions.tech,<CT300-IP>:3000
MCP_ALLOWED_HOSTS=
# MCP_TLS_CERT / MCP_TLS_KEY: optional; set BOTH to enable https (paths to cert/key)
MCP_TLS_CERT=
MCP_TLS_KEY=
